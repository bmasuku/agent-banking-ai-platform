# Copy to .env and adjust. Never commit .env or real secrets.
#   cp .env.example .env

# --- Ports (host) ---
POSTGRES_PORT=55432
BACKEND_PORT=18080
AI_PORT=8000
WEB_PORT=8088

# --- PostgreSQL ---
POSTGRES_DB=agent_banking
POSTGRES_USER=agent_banking
POSTGRES_PASSWORD=change-me-postgres-password

# --- Spring Boot ---
# Base64-encoded HMAC key (>= 256 bits). Generate: openssl rand -base64 48
JWT_SECRET=c2ltdWxhdGVkLWFnZW50LWJhbmtpbmctcGxhdGZvcm0tbG9jYWwtZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1tZQ==
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
APP_TIMEZONE=Africa/Harare
DEMO_SEED_ON_STARTUP=true
DEMO_HISTORY_DAYS=14
DEMO_DEFAULT_PASSWORD=Demo@2026!
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@agentbanking.local
BOOTSTRAP_ADMIN_PASSWORD=Demo@2026!
SCHEDULING_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://127.0.0.1:5173,http://127.0.0.1:8088,http://localhost:8081,http://localhost:8082,http://localhost:19006

# Shared internal key between Spring Boot and the AI service (change for any shared environment)
AI_SERVICE_ENABLED=true
AI_SERVICE_API_KEY=local-dev-internal-key-change-me

# --- AI service (optional LLM for assistant) ---
AI_LLM_PROVIDER=none
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=gpt-4o-mini

# --- Web (Docker build) ---
# Relative path is proxied by nginx to the backend.
VITE_API_URL=/api/v1

# --- Mobile (Expo — not run inside Compose) ---
# Android emulator → host machine mapped backend port:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:18080/api/v1
# iOS simulator / web:
#   EXPO_PUBLIC_API_URL=http://localhost:18080/api/v1
# Physical device (same LAN as your machine):
#   EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:18080/api/v1
EXPO_PUBLIC_API_URL=http://localhost:18080/api/v1
